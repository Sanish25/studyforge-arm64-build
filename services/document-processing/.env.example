# Local development only. Export these for host commands; Django does not load this file.
PROCESSING_SECRET_KEY=local-processing-only-change-before-deployment
PROCESSING_DB_NAME=studyforge_processing
PROCESSING_DB_USER=studyforge_processing
PROCESSING_DB_PASSWORD=processing_local_dev
PROCESSING_DB_HOST=127.0.0.1
PROCESSING_DB_PORT=5432
# PROCESSING_DB_SSLMODE=verify-full
# PROCESSING_DB_SSLROOTCERT=/path/to/postgres-ca.pem
PROCESSING_REDIS_URL=redis://127.0.0.1:6379/0
PROCESSING_DJANGO_API_URL=http://host.docker.internal:8000
# Production worker direct object access; default django keeps local retrieval.
PROCESSING_SOURCE_MODE=django
# PROCESSING_SOURCE_MODE=s3
# PROCESSING_STORAGE_BUCKET=your-private-bucket
# PROCESSING_STORAGE_REGION=your-region
# PROCESSING_STORAGE_ENDPOINT_URL=https://your-storage-endpoint
# PROCESSING_STORAGE_ACCESS_KEY_ID=  # Omit both keys for workload identity.
# PROCESSING_STORAGE_SECRET_ACCESS_KEY=
# PROCESSING_STORAGE_SESSION_TOKEN=
# PROCESSING_STORAGE_CA_BUNDLE=/path/to/storage-ca.pem
# PROCESSING_STORAGE_CONNECT_TIMEOUT=3
# PROCESSING_STORAGE_READ_TIMEOUT=10
# PROCESSING_STORAGE_ADDRESSING_STYLE=path
# PROCESSING_STORAGE_ALLOW_HTTP=1  # Isolated local MinIO only.
# STUDYFORGE_REQUIRE_SECURE_CONNECTIONS=1
# PROCESSING_REQUIRE_DIRECT_STORAGE=1  # Production worker only.
# Must match Django; used for PDF retrieval and result callbacks.
PROCESSING_SERVICE_TOKEN=
PROCESSING_ALLOWED_HOSTS=localhost,127.0.0.1,document-processing
PROCESSING_HTTP_PORT=8001
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=16
